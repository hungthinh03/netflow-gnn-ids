# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ===== Virtual environments =====
.venv/
venv/
env/
ENV/

# ===== Môi trường & bí mật =====
.env
.env.*
!.env.example

# ===== Dữ liệu (không commit; giữ lại .gitkeep và schema) =====
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.feather
*.pcap
*.pcapng
*.zip
*.gz
*.7z
*.rar

# ===== Model artifacts / checkpoints =====
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.h5
*.onnx

# ===== Kết quả thực nghiệm lớn / log =====
results/*
!results/.gitkeep
!results/*.md
logs/
*.log
runs/
wandb/
mlruns/
lightning_logs/

# ===== Jupyter =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ===== Testing / lint cache =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# ===== Node.js (dashboard frontend) =====
node_modules/
app/frontend/dist/
app/frontend/build/
app/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Docker =====
docker-compose.override.yml

